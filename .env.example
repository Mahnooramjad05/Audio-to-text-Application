# Copy this file to .env and fill in real values, or export the variable
# directly in your shell. server.py reads this via os.environ.get(...).
#
# Optional. Only used if the `anthropic` package is installed. When unset,
# llm_postprocess() in server.py falls back to a deterministic regex-based
# transcript cleanup instead of calling the Claude API.
ANTHROPIC_API_KEY=
